<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:gravity="center_vertical"
	android:orientation="horizontal">

	<TextView
		android:id="@+id/page_navigation_previous"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:background="?android:attr/selectableItemBackground"
		android:clickable="true"
		android:focusable="true"
		android:gravity="center_vertical"
		android:minHeight="@dimen/pref_custom_min_height"
		android:paddingHorizontal="@dimen/large_pref_spacing_horizontal"
		android:text="@string/delete_words_page_previous"
		android:textColor="?android:attr/textColorSecondary"
		android:textSize="@dimen/large_pref_summary_size" />

	<Space
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:layout_weight="1" />

	<TextView
		android:id="@+id/page_navigation_next"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:background="?android:attr/selectableItemBackground"
		android:clickable="true"
		android:focusable="true"
		android:gravity="center_vertical"
		android:minHeight="@dimen/pref_custom_min_height"
		android:paddingHorizontal="@dimen/large_pref_spacing_horizontal"
		android:text="@string/delete_words_page_next"
		android:textColor="?android:attr/textColorSecondary"
		android:textSize="@dimen/large_pref_summary_size" />
</LinearLayout>
